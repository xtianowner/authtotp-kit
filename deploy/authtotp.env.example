# /etc/authtotp/env — non-secret settings (root:authtotp 0640). The master key is NOT here; it lives in
# /etc/authtotp/master-key (owner authtotp, mode 0400) and is referenced by AUTHTOTP_MASTER_KEY_FILE.
# Replace vault.example.com with your vault domain.
AUTHTOTP_DATA_DIR=/srv/authtotp/data
AUTHTOTP_FRONTEND_DIST=/srv/authtotp/app/dist
AUTHTOTP_MASTER_KEY_FILE=/etc/authtotp/master-key
AUTHTOTP_ALLOWED_HOSTS=vault.example.com,127.0.0.1,localhost
AUTHTOTP_ALLOWED_ORIGINS=https://vault.example.com
AUTHTOTP_COOKIE_SECURE=1
AUTHTOTP_TRUSTED_PROXIES=127.0.0.1
# Required for any internet-facing install: first-time admin setup and sign-in before the authenticator app is
# bound are accepted ONLY from loopback (i.e. through an SSH tunnel), so nobody else can claim a fresh server.
AUTHTOTP_REQUIRE_ADMIN_TOTP=1
# Admin session lifetime in hours (sliding renewal). 2160 = about 90 days of inactivity.
AUTHTOTP_SESSION_HOURS=2160
# Default caller token lifetime in hours; the open-source default is 720 (30 days). 0 = never expire.
# When creating a token you can also pick its lifetime one by one in the vault UI.
AUTHTOTP_CALLER_TOKEN_HOURS=720
PYTHONDONTWRITEBYTECODE=1
